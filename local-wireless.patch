diff --git a/include/mkw/netplay.hpp b/include/mkw/netplay.hpp
new file mode 100644
index 0000000..d2dddaf
--- /dev/null
+++ b/include/mkw/netplay.hpp
@@ -0,0 +1,87 @@
+#pragma once
+// Local wireless (UDS: console to console, no access point) VS races, 2 to 12 racers.
+// Star layout: guests talk only to the host; the host bundles every kart into one packet.
+// Every racer has a race ID (its grid position), the same on every console. Each console
+// simulates its own kart as racer index 0; the host also drives the CPUs. Other racers are
+// driven by their received inputs and pulled toward their received state.
+#include <cstdint>
+
+namespace Kinoko::Kart { class KartObject; }
+
+namespace mkw::net {
+enum class Role : uint8_t { None, Host, Guest };
+Role role();
+bool connected();
+// At start-up, with L or R held: text lobby on the lower screen (host / join).
+// Call before the renderer starts; it restores the lower LCD format it changes.
+void bootLobby();
+// Pump received packets and keep-alives. Cheap; call every frame anywhere.
+void poll();
+void shutdown();
+// The Local Wireless menu page (main menu > Multiplayer). These return at once; joining
+// keeps searching for a host in the background.
+void hostBegin();
+void joinBegin();
+// One short line for the page's help bar: what the link is doing.
+const char* statusText();
+
+struct StartInfo { uint8_t course = 0, engineClass = 2; bool mirror = false; uint8_t items = 0; };
+// Host: offer a VS race to every guest, collect answers and send the roster: the host,
+// the guests who accepted, then `cpuCount` CPUs. True when at least one guest joined.
+bool hostStartRace(const StartInfo& info, uint16_t hostGarage, const uint16_t* cpuGarages, unsigned cpuCount);
+// Guest: a race the host offered, not yet answered.
+bool guestStartPending(StartInfo& out);
+// Guest: answer the offer. Accepting waits for the roster: true when in the race.
+bool guestAnswer(bool accept, uint16_t garage);
+// Guest: accept now (on the results screen), join the race once the screen is left.
+void guestAcceptEarly(uint16_t garage);
+
+bool inRace();
+// This console's player name (the license's, UTF-16, up to 10 units), sent with its answers.
+void setLocalName(const uint16_t* name);
+// A racer's player name (nullptr for CPUs and outside a shared race).
+const uint16_t* nameFor(unsigned index);
+// The host stopped answering during a race: every other kart is now driven here.
+bool hostLost();
+// The shared race's racers: index 0 is this console, 1..count-1 the others.
+unsigned raceCount();
+uint16_t garageFor(unsigned index);
+uint8_t startPositionFor(unsigned index); // one-based grid slot, the same on every console
+uint16_t externalMask();                  // racers driven from the network here
+bool ownsRacer(unsigned index);           // this console decides that racer's items and hits
+// While a loaded race holds before its intro: true once every console has loaded.
+bool raceReady();
+// Before each simulation step: every remote racer's inputs and state correction.
+void applyRemotes();
+// After each simulation step: this console's racer (and, on the host, its CPUs).
+void sendLocal(Kinoko::Kart::KartObject* kart, unsigned buttons, unsigned stickRaw, unsigned trick, bool finished);
+void endRace();
+// The host left its results: on a guest still racing, the race ends now.
+void hostRaceOver();
+bool takeRaceOver();
+// Lobby: the host sends every console to character selection (VS); guests take it once.
+void hostLobbyGo();
+bool takeLobbyGo();
+
+// Items. The console that owns a racer decides its item boxes and the hits it takes and
+// tells the others; item buttons travel with the kart state.
+struct ItemNews {
+    enum Kind : uint8_t { Got = 1, Hit = 2, Throw = 3 } kind = Got;
+    uint8_t racer = 0;             // racer index on this console
+    uint8_t item = 20;             // ItemKind
+    uint8_t owner = 12;            // Hit: the attacker's racer index; Throw: the target (12: none)
+    int8_t action = -1;            // Hit: the kart action; Throw: 1 when thrown backwards
+    float direction[3]{}, position[3]{}; // Throw: velocity and position
+    float flight[3]{}, speed = 0;  // Throw: flight direction and travel speed
+};
+bool popItemNews(ItemNews& out);
+void sendItemGot(unsigned racer, uint8_t item);
+void sendHit(unsigned racer, int8_t action, unsigned ownerIndex, uint8_t item, const float direction[3], const float position[3]);
+void sendThrow(unsigned racer, uint8_t item, const float position[3], const float velocity[3], const float flight[3], float speed, unsigned targetIndex, bool backwards);
+// This tick's item buttons for a racer this console owns (sent with its next update),
+// and a remote racer's latest.
+void setItemInput(unsigned racer, bool use, bool backwards, bool forwards);
+void remoteItemInput(unsigned index, bool& use, bool& backwards, bool& forwards);
+// One short line of link statistics for the debug overlay (empty when not connected).
+void debugLine(char* out, unsigned size);
+}
