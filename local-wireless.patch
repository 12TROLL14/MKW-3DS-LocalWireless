diff --git a/src/netplay.cpp b/src/netplay.cpp
new file mode 100644
index 0000000..a6ce452
--- /dev/null
+++ b/src/netplay.cpp
@@ -0,0 +1,720 @@
+// Local wireless VS races, 2 to 12 racers (see include/mkw/netplay.hpp).
+#include <mkw/netplay.hpp>
+#include <3ds.h>
+#include <game/kart/KartObject.hh>
+#include <game/kart/KartObjectProxy.hh>
+#include <game/kart/KartObjectManager.hh>
+#include <game/kart/KartDynamics.hh>
+#include <game/kart/KartMove.hh>
+#include <game/system/KPadController.hh>
+#include <game/system/KPadDirector.hh>
+#include <game/system/RaceManager.hh>
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace mkw::net {
+namespace {
+constexpr u32 CommId = 0x4D4B5733;   // "MKW3": only this game's networks are seen.
+constexpr u8 MaxNodes = 12;
+constexpr unsigned MaxSlots = 12;    // link slot = UDS node ID - 1; the host is slot 0
+constexpr unsigned MaxRacers = 12;   // race ID = grid position
+constexpr u8 NoSlot = 0xff;          // a roster entry without a console: a CPU
+constexpr u8 Channel = 1;
+constexpr char Passphrase[] = "mkw-3ds local play v1";
+constexpr u8 Magic = 0x6B;
+constexpr u8 Protocol = 7;           // Bump when packets change: every console must match.
+constexpr unsigned SendEvery = 3;    // ticks between kart updates: 20 a second
+
+enum class Type : u8 { Hello = 1, Start, Accept, Decline, Roster, Ready, Go, State, Bundle, Bye, Ping, Pong, Event, RaceOver, LobbyGo };
+struct Header { u8 magic, protocol, type, count; u16 raceId, pad; };
+struct StartPacket { Header h; u8 course, engineClass, mirror, items; };
+struct AcceptPacket { Header h; u16 garage, pad; u16 name[10]; };
+struct RosterEntry { u8 slot, pad; u16 garage; u16 name[10]; };
+struct RosterPacket { Header h; RosterEntry e[MaxRacers]; };
+struct PingPacket { Header h; u64 sentAt; };
+// One kart, compact: 36 bytes. Twelve fit one bundle of 440 bytes.
+struct KartState {
+    u8 racer, buttons, stickTrick, flags;  // stick 0..14 in the low nibble, trick above;
+                                           // flags: 1 finished, 2 use item, 4 back, 8 forward
+    u32 tick;                              // the sending console's simulation tick
+    float pos[3];
+    s16 vel[3];                            // per tick, 1/64 units
+    s16 rot[4];                            // quaternion x,y,z,w, 1/32767
+    s16 speed;                             // 1/64 units
+};
+struct StatePacket { Header h; KartState k; };
+struct BundlePacket { Header h; KartState k[MaxRacers]; };
+// An item event, sent three times; the host passes guests' events on to everyone.
+struct NetEvent { u8 kind, origin, item, owner; s8 action; u8 pad; u16 seq; float direction[3], position[3], flight[3], speed; };
+struct EventPacket { Header h; NetEvent e; };
+
+s16 pack(float v, float scale) { return s16(std::clamp(std::lround(v * scale), -32767L, 32767L)); }
+
+// ---- Link ----
+Role role_ = Role::None;
+bool up_ = false;
+udsBindContext bind_{};
+u16 myNode_ = 0;
+unsigned mySlot_ = 0;
+u64 hostLastRecv_ = 0;                      // guest: the host's last packet
+std::array<u64, MaxSlots> guestLastRecv_{}; // host: each guest's last packet
+u64 lastHello_ = 0, lastPing_ = 0;
+u16 raceId_ = 0;
+
+// ---- Offer / roster ----
+bool offerPending_ = false, acceptedEarly_ = false; StartInfo offer_{}; u16 earlyGarage_ = 0;
+std::array<int, MaxSlots> answers_{};       // host: 0 none, 1 accepted, -1 declined
+std::array<u16, MaxSlots> answerGarage_{};
+bool rosterReceived_ = false;
+unsigned rosterCount_ = 0;
+std::array<u8, MaxRacers> rosterSlot_{};    // by race ID; NoSlot for a CPU
+std::array<u16, MaxRacers> rosterGarage_{};
+std::array<std::array<u16, 10>, MaxRacers> rosterName_{};
+std::array<std::array<u16, 10>, MaxSlots> answerName_{};
+std::array<u16, 10> myName_{};
+bool hostLost_ = false;
+unsigned myRacer_ = 0;                      // this console's race ID
+std::array<u8, MaxRacers> indexRacer_{};    // racer index -> race ID (index 0 = this console)
+std::array<u8, MaxRacers> racerIndex_{};    // race ID -> racer index
+
+// ---- Race ----
+bool inRace_ = false, go_ = false, raceOver_ = false, lobbyGo_ = false;
+std::array<bool, MaxSlots> ready_{};        // host: guests that loaded
+struct Remote { bool have = false, haveOffset = false; KartState k{}; u64 arrival = 0; int minOffset = 0; };
+std::array<Remote, MaxRacers> remotes_{};   // by race ID
+u32 localTick_ = 0;
+std::array<std::array<float, 3>, MaxRacers> prevPos_{}; bool havePrev_ = false; // by racer index (owned ones)
+std::array<u8, MaxRacers> itemBits_{};      // by racer index: buttons since the last update (use is OR-ed)
+u64 readyWaitStart_ = 0, lastReadySend_ = 0, goSentAt_ = 0; unsigned goRepeats_ = 0;
+u16 eventSeq_ = 0;
+std::array<u16, MaxRacers> lastSeq_{}; std::array<bool, MaxRacers> haveSeq_{};
+std::array<ItemNews, 48> news_{}; unsigned newsHead_ = 0, newsCount_ = 0;
+
+// ---- Statistics ----
+unsigned sent_ = 0, sendFails_ = 0, received_ = 0, maxBatch_ = 0, rttMs_ = 0, rttMinMs_ = ~0u;
+
+u64 now() { return svcGetSystemTick(); }
+u64 ms(u64 t) { return t * (SYSCLOCK_ARM11 / 1000); }
+unsigned toMs(u64 ticks) { return unsigned(ticks / (SYSCLOCK_ARM11 / 1000)); }
+
+// SD writes can stall a frame, so during a race lines wait in memory until it ends.
+char logBuffer_[6144]; size_t logUsed_ = 0; bool logHold_ = false;
+void flushLog() {
+    if (!logUsed_) return;
+    if (FILE* f = fopen("sdmc:/3ds/mkw-3ds/netplay.log", "a")) { fwrite(logBuffer_, 1, logUsed_, f); fclose(f); }
+    logUsed_ = 0;
+}
+void log(const char* fmt, ...) {
+    char text[200];
+    va_list a; va_start(a, fmt); vsnprintf(text, sizeof text, fmt, a); va_end(a);
+    char line[224]; const int n = snprintf(line, sizeof line, "[%.3f] %s\n", double(now()) / SYSCLOCK_ARM11, text);
+    if (n <= 0) return;
+    if (logUsed_ + size_t(n) > sizeof logBuffer_) { if (logHold_) return; flushLog(); }
+    std::memcpy(logBuffer_ + logUsed_, line, size_t(n)); logUsed_ += size_t(n);
+    if (!logHold_) flushLog();
+}
+
+Header header(Type t, u8 count = 0) { Header h{}; h.magic = Magic; h.protocol = Protocol; h.type = u8(t); h.count = count; h.raceId = raceId_; return h; }
+void sendTo(u16 node, const void* data, size_t size) {
+    if (!up_) return;
+    const Result r = udsSendTo(node, Channel, UDS_SENDFLAG_Default, data, size);
+    if (R_FAILED(r)) { if (sendFails_++ < 8) log("send failed %08lx", (unsigned long)r); }
+    else ++sent_;
+}
+// Guests only ever talk to the host; the host talks to everyone at once.
+void send(const void* data, size_t size) { sendTo(role_ == Role::Host ? UDS_BROADCAST_NETWORKNODEID : UDS_HOST_NETWORKNODEID, data, size); }
+void sendSimple(Type t) { const Header h = header(t); send(&h, sizeof h); }
+
+bool guestAlive(unsigned slot) { return slot && slot < MaxSlots && guestLastRecv_[slot] && now() - guestLastRecv_[slot] < ms(5000); }
+unsigned guestCount() { unsigned n = 0; for (unsigned s = 1; s < MaxSlots; ++s) n += guestAlive(s); return n; }
+bool isCpu(unsigned racer) { return racer < rosterCount_ && rosterSlot_[racer] == NoSlot; }
+int racerOfSlot(unsigned slot) { for (unsigned r = 0; r < rosterCount_; ++r) if (rosterSlot_[r] == slot) return int(r); return -1; }
+int indexOf(unsigned racer) { return racer < rosterCount_ ? int(racerIndex_[racer]) : -1; }
+
+void storeRemote(const KartState& k) {
+    if (k.racer >= rosterCount_ || k.racer == myRacer_) return;
+    if (role_ == Role::Host && isCpu(k.racer)) return; // the host drives its CPUs itself
+    Remote& r = remotes_[k.racer];
+    if (r.have && k.tick <= r.k.tick) return;
+    r.k = k; r.have = true; r.arrival = now();
+    // The smallest local-minus-remote tick gap: the two clocks' offset at the best latency.
+    const int offset = int(localTick_) - int(k.tick);
+    if (!r.haveOffset || offset < r.minOffset) { r.minOffset = offset; r.haveOffset = true; }
+}
+
+void queueEvent(const NetEvent& e) {
+    const int racer = indexOf(e.origin);
+    if (racer <= 0 || newsCount_ >= news_.size()) return; // not a remote racer here, or full
+    ItemNews n; n.kind = ItemNews::Kind(e.kind); n.racer = u8(racer); n.item = e.item; n.action = e.action;
+    const int owner = e.owner < rosterCount_ ? indexOf(e.owner) : -1; n.owner = owner >= 0 ? u8(owner) : 12;
+    for (int a = 0; a < 3; ++a) { n.direction[a] = e.direction[a]; n.position[a] = e.position[a]; n.flight[a] = e.flight[a]; }
+    n.speed = e.speed;
+    news_[(newsHead_ + newsCount_++) % news_.size()] = n;
+}
+
+void sendEvent(unsigned racerIndex, NetEvent e) {
+    if (racerIndex >= rosterCount_) return;
+    e.origin = indexRacer_[racerIndex]; e.seq = ++eventSeq_;
+    EventPacket p; p.h = header(Type::Event); p.e = e;
+    for (int i = 0; i < 3; ++i) send(&p, sizeof p);
+}
+
+void handle(const u8* data, size_t size, u16 source) {
+    if (size < sizeof(Header)) return;
+    Header h; std::memcpy(&h, data, sizeof h);
+    if (h.magic != Magic) return;
+    if (h.protocol != Protocol) { static bool said = false; if (!said) { said = true; log("console with protocol %u (ours %u): ignored", h.protocol, Protocol); } return; }
+    ++received_;
+    const unsigned from = source >= 1 && source <= MaxSlots ? source - 1u : MaxSlots;
+    if (role_ == Role::Host) { if (from && from < MaxSlots) { if (!guestLastRecv_[from]) log("guest %u joined", from); guestLastRecv_[from] = now(); } }
+    else hostLastRecv_ = now();
+    switch (Type(h.type)) {
+    case Type::Hello: break;
+    case Type::Start:
+        if (role_ == Role::Guest && size >= sizeof(StartPacket)) {
+            StartPacket p; std::memcpy(&p, data, sizeof p);
+            if (offerPending_ && raceId_ == h.raceId) break;   // a repeat
+            if (rosterReceived_ && raceId_ == h.raceId) break; // already answered
+            raceId_ = h.raceId; offerPending_ = true; rosterReceived_ = false; acceptedEarly_ = false;
+            offer_ = {p.course, p.engineClass, p.mirror != 0, p.items};
+            log("offer race=%u course=%u class=%u", raceId_, p.course, p.engineClass);
+        }
+        break;
+    case Type::Accept:
+        if (role_ == Role::Host && h.raceId == raceId_ && from < MaxSlots && size >= sizeof(AcceptPacket)) {
+            AcceptPacket p; std::memcpy(&p, data, sizeof p);
+            answers_[from] = 1; answerGarage_[from] = p.garage; std::memcpy(answerName_[from].data(), p.name, sizeof p.name);
+        }
+        break;
+    case Type::Decline:
+        if (role_ == Role::Host && h.raceId == raceId_ && from < MaxSlots) answers_[from] = -1;
+        break;
+    case Type::Roster:
+        if (role_ == Role::Guest && h.raceId == raceId_ && !rosterReceived_ && h.count <= MaxRacers &&
+            size >= sizeof(Header) + h.count * sizeof(RosterEntry)) {
+            RosterPacket p{}; std::memcpy(&p, data, std::min(size, sizeof p));
+            rosterCount_ = h.count;
+            for (unsigned i = 0; i < rosterCount_; ++i) { rosterSlot_[i] = p.e[i].slot; rosterGarage_[i] = p.e[i].garage; std::memcpy(rosterName_[i].data(), p.e[i].name, sizeof p.e[i].name); }
+            rosterReceived_ = true;
+        }
+        break;
+    case Type::Ready:
+        if (role_ == Role::Host && h.raceId == raceId_ && from < MaxSlots && !ready_[from]) { ready_[from] = true; log("guest %u loaded", from); }
+        break;
+    case Type::Go:
+        if (role_ == Role::Guest && h.raceId == raceId_ && !go_) { go_ = true; log("go race=%u", raceId_); }
+        break;
+    case Type::LobbyGo:
+        if (role_ == Role::Guest && !inRace_ && !lobbyGo_) { lobbyGo_ = true; log("lobby go"); }
+        break;
+    case Type::RaceOver:
+        if (role_ == Role::Guest && h.raceId == raceId_ && inRace_ && !raceOver_) { raceOver_ = true; log("race over"); }
+        break;
+    case Type::State:
+        if (role_ == Role::Host && inRace_ && h.raceId == raceId_ && size >= sizeof(StatePacket)) {
+            StatePacket p; std::memcpy(&p, data, sizeof p);
+            const int racer = racerOfSlot(from); // trust the link, not the packet
+            if (racer < 0) break;
+            p.k.racer = u8(racer);
+            storeRemote(p.k);
+        }
+        break;
+    case Type::Bundle:
+        if (role_ == Role::Guest && inRace_ && h.raceId == raceId_ && h.count <= MaxRacers &&
+            size >= sizeof(Header) + h.count * sizeof(KartState)) {
+            BundlePacket p; std::memcpy(&p, data, std::min(size, sizeof p));
+            for (unsigned i = 0; i < h.count; ++i) storeRemote(p.k[i]);
+        }
+        break;
+    case Type::Event:
+        if (inRace_ && h.raceId == raceId_ && size >= sizeof(EventPacket)) {
+            EventPacket p; std::memcpy(&p, data, sizeof p);
+            if (role_ == Role::Host) { const int racer = racerOfSlot(from); if (racer < 0) break; p.e.origin = u8(racer); } // trust the link
+            const unsigned o = p.e.origin;
+            if (o >= rosterCount_ || o == myRacer_ || (role_ == Role::Host && isCpu(o))) break;
+            if (haveSeq_[o] && s16(u16(p.e.seq - lastSeq_[o])) <= 0) break; // a copy already seen
+            haveSeq_[o] = true; lastSeq_[o] = p.e.seq;
+            queueEvent(p.e);
+            if (role_ == Role::Host) for (int i = 0; i < 3; ++i) send(&p, sizeof p); // pass it on
+        }
+        break;
+    case Type::Ping:
+        if (size >= sizeof(PingPacket)) { PingPacket p; std::memcpy(&p, data, sizeof p); p.h = header(Type::Pong); sendTo(source, &p, sizeof p); }
+        break;
+    case Type::Pong:
+        if (size >= sizeof(PingPacket)) {
+            PingPacket p; std::memcpy(&p, data, sizeof p);
+            rttMs_ = toMs(now() - p.sentAt); rttMinMs_ = std::min(rttMinMs_, rttMs_);
+        }
+        break;
+    case Type::Bye:
+        if (role_ == Role::Host && from < MaxSlots) { guestLastRecv_[from] = 0; log("guest %u left", from); }
+        else if (role_ == Role::Guest) { hostLastRecv_ = 0; log("host left"); }
+        break;
+    }
+}
+
+void restoreLowerScreen() {
+    // consoleInit made it RGB565 and single-buffered; the renderer needs the defaults.
+    gfxSetScreenFormat(GFX_BOTTOM, GSP_BGR8_OES);
+    gfxSetDoubleBuffering(GFX_BOTTOM, true);
+}
+
+void stopUds() {
+    if (!up_) return;
+    sendSimple(Type::Bye);
+    if (role_ == Role::Host) udsDestroyNetwork(); else udsDisconnectNetwork();
+    udsUnbind(&bind_);
+    up_ = false;
+}
+
+void learnNode() {
+    udsConnectionStatus status{};
+    if (R_SUCCEEDED(udsGetConnectionStatus(&status))) myNode_ = status.cur_NetworkNodeID;
+    mySlot_ = myNode_ >= 1 && myNode_ <= MaxSlots ? myNode_ - 1u : 0;
+    log("node %u slot %u", myNode_, mySlot_);
+}
+
+void beginRace() {
+    // Racer 0 is this console; the others follow in grid order.
+    const int me = racerOfSlot(mySlot_); myRacer_ = me >= 0 ? unsigned(me) : 0;
+    unsigned n = 1; indexRacer_[0] = u8(myRacer_); racerIndex_[myRacer_] = 0;
+    for (unsigned r = 0; r < rosterCount_ && n < MaxRacers; ++r) if (r != myRacer_) { indexRacer_[n] = u8(r); racerIndex_[r] = u8(n); ++n; }
+    inRace_ = true; go_ = false; raceOver_ = false; hostLost_ = false; ready_.fill(false); remotes_ = {};
+    localTick_ = 0; havePrev_ = false; itemBits_.fill(0); readyWaitStart_ = 0; lastReadySend_ = 0; goSentAt_ = 0; goRepeats_ = 0;
+    eventSeq_ = 0; haveSeq_.fill(false); newsHead_ = newsCount_ = 0;
+    log("race %u begins: %u racers, this console is racer %u", raceId_, rosterCount_, myRacer_);
+    logHold_ = true;
+}
+
+// ---- Background search for a host (a scan blocks for a while) ----
+bool exitHooked_ = false, joining_ = false;
+char status_[96] = "";
+Thread scanThread_ = nullptr; volatile bool scanStop_ = false;
+void scanOnce() {
+    static u8 scan[0x4000];
+    udsNetworkScanInfo* networks = nullptr; size_t total = 0;
+    Result r = udsScanBeacons(scan, sizeof scan, &networks, &total, CommId, 0, nullptr, false);
+    if (R_SUCCEEDED(r) && total) {
+        r = udsConnectNetwork(&networks[0].network, Passphrase, sizeof Passphrase, &bind_,
+                              UDS_BROADCAST_NETWORKNODEID, UDSCONTYPE_Client, Channel, UDS_DEFAULT_RECVBUFSIZE);
+        if (R_SUCCEEDED(r)) { learnNode(); hostLastRecv_ = now(); up_ = true; joining_ = false; log("joined (menu)"); }
+        else log("udsConnectNetwork %08lx", (unsigned long)r);
+    }
+    free(networks);
+}
+void scanMain(void*) {
+    while (!scanStop_ && joining_ && !up_) { scanOnce(); for (int i = 0; i < 10 && !scanStop_; ++i) svcSleepThread(50 * 1000000LL); }
+}
+void stopScan() {
+    if (!scanThread_) return;
+    scanStop_ = true; threadJoin(scanThread_, U64_MAX); threadFree(scanThread_); scanThread_ = nullptr;
+}
+bool startUds() {
+    const Result r = udsInit(0x3000, nullptr);
+    if (R_SUCCEEDED(r)) { if (!exitHooked_) { exitHooked_ = true; atexit(shutdown); } return true; }
+    log("udsInit %08lx", (unsigned long)r);
+    snprintf(status_, sizeof status_, "Wireless error %08lX", (unsigned long)r);
+    return false;
+}
+void resetLink() { guestLastRecv_.fill(0); hostLastRecv_ = 0; raceId_ = 0; offerPending_ = acceptedEarly_ = rosterReceived_ = false; inRace_ = false; status_[0] = 0; }
+} // namespace
+
+Role role() { return role_; }
+bool connected() {
+    if (!up_) return false;
+    if (role_ == Role::Host) return guestCount() > 0;
+    return hostLastRecv_ && now() - hostLastRecv_ < ms(5000);
+}
+
+void poll() {
+    if (scanThread_ && (up_ || !joining_)) stopScan(); // the search ended: collect its thread
+    if (!up_) return;
+    // Read until the queue is empty. (udsWaitDataAvailable is not a reliable
+    // "anything waiting?" test: gating on it left packets queued for seconds.)
+    unsigned batch = 0;
+    for (; batch < 1024; ++batch) {
+        alignas(8) static u8 buffer[UDS_DATAFRAME_MAXSIZE];
+        size_t actual = 0; u16 source = 0;
+        if (R_FAILED(udsPullPacket(&bind_, buffer, sizeof buffer, &actual, &source)) || !actual) break;
+        handle(buffer, actual, source);
+    }
+    maxBatch_ = std::max(maxBatch_, batch);
+    if (now() - lastHello_ > ms(1000)) { lastHello_ = now(); sendSimple(Type::Hello); }
+    if (now() - lastPing_ > ms(500)) { lastPing_ = now(); PingPacket p{}; p.h = header(Type::Ping); p.sentAt = now(); send(&p, sizeof p); }
+}
+
+void bootLobby() {
+    hidScanInput();
+    if (!(hidKeysHeld() & (KEY_L | KEY_R))) return;
+    static PrintConsole console;
+    consoleInit(GFX_BOTTOM, &console);
+    auto frame = [] { gfxFlushBuffers(); gfxSwapBuffers(); gspWaitForVBlank(); };
+    auto wait = [&](const char* text) {
+        printf("%s\n\nPress A to continue.\n", text);
+        while (aptMainLoop()) { hidScanInput(); if (hidKeysDown() & (KEY_A | KEY_B | KEY_START)) break; frame(); }
+    };
+    printf("\x1b[2J== MKW local wireless ==\n\n"
+           "(Also in the main menu: Multiplayer.)\n\n"
+           "A: host\nB: join\nSTART: play alone\n");
+    Role chosen = Role::None;
+    while (aptMainLoop()) {
+        hidScanInput(); const u32 down = hidKeysDown();
+        if (down & KEY_A) { chosen = Role::Host; break; }
+        if (down & KEY_B) { chosen = Role::Guest; break; }
+        if (down & KEY_START) break;
+        frame();
+    }
+    if (chosen == Role::None) { restoreLowerScreen(); return; }
+    if (chosen == Role::Host) hostBegin(); else joinBegin();
+    const u64 start = now(); unsigned shown = ~0u;
+    while (aptMainLoop() && role_ != Role::None) {
+        hidScanInput(); const u32 down = hidKeysDown();
+        if (down & KEY_START) { shutdown(); break; }
+        poll();
+        const unsigned n = role_ == Role::Host ? guestCount() + 1 : connected() ? 2 : 0;
+        if (n != shown) { shown = n; printf("\x1b[10;0H%s          \n", statusText()); }
+        if (role_ == Role::Host && n > 1 && (down & KEY_A)) break;
+        if (role_ == Role::Guest && connected()) break;
+        if (role_ == Role::Guest && now() - start > ms(30000)) { shutdown(); break; }
+        frame();
+    }
+    if (role_ != Role::None) wait(role_ == Role::Host ? "Hosting." : "Joined.");
+    restoreLowerScreen();
+}
+
+void hostBegin() {
+    if (role_ != Role::None) return;
+    if (!startUds()) return;
+    resetLink();
+    udsNetworkStruct network;
+    udsGenerateDefaultNetworkStruct(&network, CommId, 0, MaxNodes);
+    const Result r = udsCreateNetwork(&network, Passphrase, sizeof Passphrase, &bind_, Channel, UDS_DEFAULT_RECVBUFSIZE);
+    if (R_FAILED(r)) {
+        log("udsCreateNetwork %08lx", (unsigned long)r); udsExit();
+        snprintf(status_, sizeof status_, "Wireless error %08lX", (unsigned long)r);
+        return;
+    }
+    role_ = Role::Host; up_ = true; learnNode(); log("hosting");
+}
+
+void joinBegin() {
+    if (role_ != Role::None) return;
+    if (!startUds()) return;
+    resetLink();
+    role_ = Role::Guest; joining_ = true; scanStop_ = false;
+    s32 priority = 0x30; svcGetThreadPriority(&priority, CUR_THREAD_HANDLE);
+    scanThread_ = threadCreate(scanMain, nullptr, 0x4000, int(std::min<s32>(priority + 1, 0x3F)), -2, false);
+    if (!scanThread_) { log("scan thread failed"); joining_ = false; shutdown(); }
+}
+
+const char* statusText() {
+    // Short: one footer line, characters limited to menu_ui's uiWirelessGlyphs.
+    if (role_ == Role::None) return status_[0] ? status_ : "Host a race or join one";
+    if (role_ == Role::Host) {
+        const unsigned n = guestCount() + 1;
+        snprintf(status_, sizeof status_, n > 1 ? "Hosting - %u players - START to begin" : "Hosting - %u player", n);
+        return status_;
+    }
+    if (joining_ || !up_) return "Searching for a host...";
+    snprintf(status_, sizeof status_, connected() ? "Joined as player %u" : "Host not answering", mySlot_ + 1);
+    return status_;
+}
+
+void shutdown() {
+    if (role_ == Role::None) return;
+    joining_ = false; stopScan();
+    stopUds(); udsExit(); role_ = Role::None;
+}
+
+bool hostStartRace(const StartInfo& info, uint16_t hostGarage, const uint16_t* cpuGarages, unsigned cpuCount) {
+    if (role_ != Role::Host || !connected()) return false;
+    ++raceId_; answers_.fill(0);
+    StartPacket p{}; p.h = header(Type::Start);
+    p.course = info.course; p.engineClass = info.engineClass; p.mirror = info.mirror; p.items = info.items;
+    log("offer race=%u course=%u to %u guests", raceId_, info.course, guestCount());
+    const u64 start = now(); u64 lastSend = 0;
+    while (aptMainLoop() && now() - start < ms(5000)) {
+        if (now() - lastSend > ms(250)) { lastSend = now(); send(&p, sizeof p); }
+        poll();
+        bool all = true;
+        for (unsigned s = 1; s < MaxSlots; ++s) if (guestAlive(s) && !answers_[s]) all = false;
+        if (all) break;
+        svcSleepThread(5 * 1000000LL);
+    }
+    // The roster, in grid order: the host, every guest that accepted, then the CPUs.
+    RosterPacket roster{}; unsigned n = 0;
+    auto entry = [](u8 slot, u16 garage, const u16* name) { RosterEntry e{}; e.slot = slot; e.garage = garage; if (name) std::memcpy(e.name, name, sizeof e.name); return e; };
+    roster.e[n++] = entry(0, hostGarage, myName_.data());
+    for (unsigned s = 1; s < MaxSlots && n < MaxRacers; ++s) if (answers_[s] == 1) roster.e[n++] = entry(u8(s), answerGarage_[s], answerName_[s].data());
+    const unsigned humans = n;
+    for (unsigned c = 0; c < cpuCount && n < MaxRacers; ++c) roster.e[n++] = entry(NoSlot, cpuGarages[c], nullptr);
+    rosterCount_ = n;
+    for (unsigned i = 0; i < n; ++i) { rosterSlot_[i] = roster.e[i].slot; rosterGarage_[i] = roster.e[i].garage; std::memcpy(rosterName_[i].data(), roster.e[i].name, sizeof roster.e[i].name); }
+    roster.h = header(Type::Roster, u8(n));
+    const size_t size = sizeof(Header) + n * sizeof(RosterEntry);
+    for (int i = 0; i < 4; ++i) { send(&roster, size); svcSleepThread(2 * 1000000LL); }
+    log("race %u roster: %u players, %u CPUs", raceId_, humans, n - humans);
+    if (humans < 2) return false;
+    beginRace();
+    return true;
+}
+
+bool guestStartPending(StartInfo& out) {
+    if (role_ != Role::Guest) return false;
+    poll();
+    if (!offerPending_) return false;
+    out = offer_;
+    return true;
+}
+
+void guestAcceptEarly(uint16_t garage) {
+    if (role_ != Role::Guest || !offerPending_ || acceptedEarly_) return;
+    acceptedEarly_ = true; earlyGarage_ = garage;
+    AcceptPacket p{}; p.h = header(Type::Accept); p.garage = garage; std::memcpy(p.name, myName_.data(), sizeof p.name);
+    for (int i = 0; i < 3; ++i) send(&p, sizeof p);
+    log("accepted race %u early", raceId_);
+}
+
+bool guestAnswer(bool accept, uint16_t garage) {
+    offerPending_ = false;
+    if (acceptedEarly_) { acceptedEarly_ = false; garage = earlyGarage_; } // the host was told this one
+    if (!accept) { sendSimple(Type::Decline); log("declined race %u", raceId_); return false; }
+    AcceptPacket p{}; p.h = header(Type::Accept); p.garage = garage; std::memcpy(p.name, myName_.data(), sizeof p.name);
+    const u64 start = now(); u64 lastSend = 0;
+    while (aptMainLoop() && !rosterReceived_ && now() - start < ms(7000)) {
+        if (now() - lastSend > ms(250)) { lastSend = now(); send(&p, sizeof p); }
+        poll();
+        svcSleepThread(5 * 1000000LL);
+    }
+    if (!rosterReceived_) { log("race %u: no roster", raceId_); return false; }
+    if (racerOfSlot(mySlot_) < 0 || rosterCount_ < 2) { log("race %u: not in the roster", raceId_); return false; }
+    beginRace();
+    return true;
+}
+
+bool inRace() { return inRace_; }
+void setLocalName(const uint16_t* name) { myName_.fill(0); if (name) std::memcpy(myName_.data(), name, sizeof myName_); }
+const uint16_t* nameFor(unsigned index) {
+    if (!inRace_ || index >= rosterCount_) return nullptr;
+    const auto& n = rosterName_[indexRacer_[index]];
+    return n[0] ? n.data() : nullptr;
+}
+bool hostLost() { return hostLost_; }
+unsigned raceCount() { return inRace_ ? rosterCount_ : 1; }
+uint16_t garageFor(unsigned index) { return index < rosterCount_ ? rosterGarage_[indexRacer_[index]] : 0; }
+uint8_t startPositionFor(unsigned index) { return index < rosterCount_ ? u8(indexRacer_[index] + 1) : 0; }
+bool ownsRacer(unsigned index) {
+    if (!inRace_ || index >= rosterCount_) return index == 0;
+    return index == 0 || hostLost_ || (role_ == Role::Host && isCpu(indexRacer_[index]));
+}
+uint16_t externalMask() {
+    if (!inRace_) return 0;
+    uint16_t mask = 0;
+    for (unsigned i = 1; i < rosterCount_; ++i) if (!ownsRacer(i)) mask |= uint16_t(1u << i);
+    return mask;
+}
+
+bool raceReady() {
+    if (!inRace_) return true;
+    poll();
+    if (!readyWaitStart_) readyWaitStart_ = now();
+    const bool timedOut = now() - readyWaitStart_ > ms(60000);
+    if (role_ == Role::Guest) {
+        if (now() - lastReadySend_ > ms(250)) { lastReadySend_ = now(); sendSimple(Type::Ready); }
+        if (go_ || timedOut) { log(go_ ? "go after %.1f s" : "no go: racing anyway", double(now() - readyWaitStart_) / SYSCLOCK_ARM11); return true; }
+        return false;
+    }
+    // Host: go when every guest has loaded (one that left is not waited for).
+    bool all = true;
+    for (unsigned r = 1; r < rosterCount_; ++r) { const unsigned s = rosterSlot_[r]; if (s != NoSlot && !ready_[s] && guestAlive(s)) all = false; }
+    if (!all && !timedOut) return false;
+    const Header go = header(Type::Go);
+    for (int i = 0; i < 3; ++i) send(&go, sizeof go);
+    goSentAt_ = now(); goRepeats_ = 8; // repeated a few times early in the race, in case one is lost
+    log("all loaded after %.1f s: go", double(now() - readyWaitStart_) / SYSCLOCK_ARM11);
+    return true;
+}
+
+void applyRemotes() {
+    using namespace Kinoko;
+    poll();
+    auto* objects = Kart::KartObjectManager::Instance(); auto* pads = System::KPadDirector::Instance();
+    if (!objects || !pads) return;
+    // Someone left mid-race. A guest that went quiet becomes a CPU the host drives (for
+    // everyone); if the host went quiet, a guest drives every other kart itself.
+    if ((role_ == Role::Host && goSentAt_) || (role_ == Role::Guest && go_)) {
+        if (role_ == Role::Host) {
+            for (unsigned r = 1; r < rosterCount_; ++r) {
+                const u8 slot = rosterSlot_[r];
+                if (slot == NoSlot || slot >= MaxSlots || now() - guestLastRecv_[slot] < ms(2500)) continue;
+                rosterSlot_[r] = NoSlot; rosterName_[r].fill(0);
+                log("racer %u (guest %u) left: a CPU drives it now", r, slot);
+            }
+        } else if (!hostLost_ && now() - hostLastRecv_ > ms(2500)) { hostLost_ = true; log("host left mid-race: driving the other karts here"); }
+    }
+    for (unsigned i = 1; i < rosterCount_; ++i) {
+        if (ownsRacer(i)) continue;
+        const Remote& r = remotes_[indexRacer_[i]];
+        Kart::KartObject* kart = objects->object(i);
+        auto* pad = pads->hostController(i);
+        // No news for 0.6 s: let the kart coast with no inputs.
+        if (!r.have || now() - r.arrival > ms(600)) { pad->setInputsRawStick(0, 7, 7, System::Trick::None); continue; }
+        const KartState& k = r.k;
+        pad->setInputsRawStick(k.buttons, k.stickTrick & 15, 7, System::Trick(k.stickTrick >> 4));
+        // Where that kart is now: its last state, moved on by the ticks since it was sent.
+        const float dt = float(std::clamp<int>(int(localTick_) - int(k.tick) - r.minOffset, 0, 20));
+        const EGG::Vector3f vel(k.vel[0] / 64.f, k.vel[1] / 64.f, k.vel[2] / 64.f);
+        const EGG::Vector3f target = EGG::Vector3f(k.pos[0], k.pos[1], k.pos[2]) + vel * dt;
+        EGG::Quatf rot(k.rot[3] / 32767.f, k.rot[0] / 32767.f, k.rot[1] / 32767.f, k.rot[2] / 32767.f);
+        rot.normalise();
+        // The kart already drives itself from the same inputs; only its error is
+        // taken out, a little each tick, so speed and steering stay smooth.
+        const EGG::Vector3f current = kart->pos();
+        const EGG::Vector3f error = target - current;
+        if (error.length() > 1000.f) { kart->setPos(target); kart->setRot(rot); kart->move()->setSpeed(k.speed / 64.f); continue; }
+        kart->setPos(current + error * 0.12f);
+        kart->setRot(kart->fullRot().slerpTo(rot, 0.15f));
+        const float speed = kart->move()->speed();
+        kart->move()->setSpeed(speed + (k.speed / 64.f - speed) * 0.1f);
+    }
+}
+
+namespace {
+KartState stateOf(unsigned index, Kinoko::Kart::KartObject* kart, unsigned buttons, unsigned stickRaw, unsigned trick, bool finished) {
+    const auto& pos = kart->pos(); const auto& rot = kart->fullRot();
+    KartState k{};
+    k.racer = indexRacer_[index]; k.buttons = u8(buttons); k.stickTrick = u8((stickRaw & 15) | ((trick & 15) << 4));
+    k.flags = u8((finished ? 1 : 0) | itemBits_[index] << 1); itemBits_[index] = 0;
+    k.tick = localTick_;
+    k.pos[0] = pos.x; k.pos[1] = pos.y; k.pos[2] = pos.z;
+    const float here[3] = {pos.x, pos.y, pos.z};
+    for (int a = 0; a < 3; ++a) k.vel[a] = pack(here[a] - prevPos_[index][a], 64.f);
+    k.rot[0] = pack(rot.v.x, 32767.f); k.rot[1] = pack(rot.v.y, 32767.f); k.rot[2] = pack(rot.v.z, 32767.f); k.rot[3] = pack(rot.w, 32767.f);
+    k.speed = pack(kart->move()->speed(), 64.f);
+    return k;
+}
+void rememberPositions() {
+    using namespace Kinoko;
+    auto* objects = Kart::KartObjectManager::Instance(); if (!objects) return;
+    for (unsigned i = 0; i < rosterCount_; ++i) if (ownsRacer(i)) { const auto& p = objects->object(i)->pos(); prevPos_[i] = {p.x, p.y, p.z}; }
+    havePrev_ = true;
+}
+}
+
+void sendLocal(Kinoko::Kart::KartObject* kart, unsigned buttons, unsigned stickRaw, unsigned trick, bool finished) {
+    using namespace Kinoko;
+    ++localTick_;
+    if (!inRace_) return;
+    if (role_ == Role::Host && goRepeats_ && now() - goSentAt_ > ms(250)) { --goRepeats_; goSentAt_ = now(); sendSimple(Type::Go); }
+    if (!havePrev_) rememberPositions();
+    if (localTick_ % SendEvery) {
+        // Velocity is measured over the last tick before each update.
+        if (localTick_ % SendEvery == SendEvery - 1) rememberPositions();
+        return;
+    }
+    const KartState mine = stateOf(0, kart, buttons, stickRaw, trick, finished);
+    if (role_ == Role::Guest) {
+        StatePacket p; p.h = header(Type::State); p.k = mine;
+        send(&p, sizeof p);
+        return;
+    }
+    // Host: one packet with every kart: its own, each guest's latest and its CPUs.
+    BundlePacket b; unsigned n = 0;
+    b.k[n++] = mine;
+    auto* objects = Kart::KartObjectManager::Instance(); auto* pads = System::KPadDirector::Instance(); auto* race = System::RaceManager::Instance();
+    for (unsigned i = 1; i < rosterCount_ && n < MaxRacers; ++i) {
+        const unsigned racer = indexRacer_[i];
+        if (isCpu(racer)) {
+            if (!objects || !pads || !race) continue;
+            const auto& in = pads->hostController(i)->raceInputState();
+            const unsigned stick = unsigned(std::clamp<long>(std::lround(in.stick.x * 7.f) + 7, 0, 14));
+            b.k[n++] = stateOf(i, objects->object(i), in.buttons, stick, unsigned(in.trick), race->player(i).finished());
+            continue;
+        }
+        const Remote& r = remotes_[racer];
+        if (r.have && now() - r.arrival < ms(600)) b.k[n++] = r.k;
+    }
+    b.h = header(Type::Bundle, u8(n));
+    send(&b, sizeof(Header) + n * sizeof(KartState));
+}
+
+void endRace() {
+    if (inRace_) log("race %u ends", raceId_);
+    inRace_ = false; go_ = false; raceOver_ = false;
+    logHold_ = false; flushLog();
+}
+
+void hostRaceOver() {
+    if (role_ != Role::Host || !inRace_) return;
+    const Header h = header(Type::RaceOver);
+    for (int i = 0; i < 4; ++i) send(&h, sizeof h);
+}
+void hostLobbyGo() {
+    if (role_ != Role::Host || inRace_) return;
+    const Header h = header(Type::LobbyGo);
+    for (int i = 0; i < 3; ++i) send(&h, sizeof h);
+}
+bool takeLobbyGo() { const bool go = lobbyGo_; lobbyGo_ = false; return go; }
+bool takeRaceOver() { const bool over = raceOver_; raceOver_ = false; return over; }
+
+bool popItemNews(ItemNews& out) {
+    if (!newsCount_) return false;
+    out = news_[newsHead_]; newsHead_ = (newsHead_ + 1) % news_.size(); --newsCount_;
+    return true;
+}
+void sendItemGot(unsigned racer, uint8_t item) {
+    if (!inRace_ || !ownsRacer(racer)) return;
+    NetEvent e{}; e.kind = ItemNews::Got; e.item = item; e.owner = 0xff; e.action = -1;
+    sendEvent(racer, e);
+}
+void sendHit(unsigned racer, int8_t action, unsigned ownerIndex, uint8_t item, const float direction[3], const float position[3]) {
+    if (!inRace_ || !ownsRacer(racer)) return;
+    NetEvent e{}; e.kind = ItemNews::Hit; e.item = item; e.action = action;
+    e.owner = ownerIndex < rosterCount_ ? indexRacer_[ownerIndex] : 0xff;
+    for (int a = 0; a < 3; ++a) { e.direction[a] = direction[a]; e.position[a] = position[a]; }
+    sendEvent(racer, e);
+}
+void sendThrow(unsigned racer, uint8_t item, const float position[3], const float velocity[3], const float flight[3], float speed, unsigned targetIndex, bool backwards) {
+    if (!inRace_ || !ownsRacer(racer)) return;
+    NetEvent e{}; e.kind = ItemNews::Throw; e.item = item; e.action = backwards ? 1 : 0;
+    e.owner = targetIndex < rosterCount_ ? indexRacer_[targetIndex] : 0xff;
+    for (int a = 0; a < 3; ++a) { e.direction[a] = velocity[a]; e.position[a] = position[a]; e.flight[a] = flight[a]; }
+    e.speed = speed;
+    sendEvent(racer, e);
+}
+void setItemInput(unsigned racer, bool use, bool backwards, bool forwards) {
+    if (racer >= MaxRacers) return;
+    // A tap shorter than an update interval still arrives (held for at least one
+    // interval); the stick direction is the latest.
+    itemBits_[racer] = u8((itemBits_[racer] & 1) | (use ? 1 : 0) | (backwards ? 2 : 0) | (forwards ? 4 : 0));
+}
+void remoteItemInput(unsigned index, bool& use, bool& backwards, bool& forwards) {
+    use = backwards = forwards = false;
+    if (!inRace_ || index == 0 || index >= rosterCount_ || ownsRacer(index)) return;
+    const Remote& r = remotes_[indexRacer_[index]];
+    if (!r.have || now() - r.arrival > ms(600)) return;
