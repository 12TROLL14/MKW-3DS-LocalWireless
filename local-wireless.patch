+void Renderer::kickGpu(){
+    if(!earlyGpuStart)return;
+    gxCmdQueue_s& queue=__C3D_Context;
+    // Every split takes a queue entry until the next C3D_FrameBegin; keep room
+    // for the frame's own splits (bloom, shadows) and its end + 3 transfers.
+    if(queue.maxEntries<32||queue.numEntries>=16)return;
+    lastKick_=stats_.drawCalls;
+    C3D_FrameSplit(GX_CMDLIST_FLUSH);
+    // Once running, later list submissions start on their own (gxCmdQueueAdd).
+    gxCmdQueueRun(&queue);
+}
+}
