+extern "C" gxCmdQueue_s __C3D_Context;
+void Renderer::endCategoryNow(unsigned k){
+    if(k<stats_.categories.size())stats_.categories[k]=uint16_t(stats_.categories[k]+stats_.drawCalls-stats_.categoryMark);
+    // Start the GPU on what is recorded so far (citro3d otherwise runs nothing
+    // until C3D_FrameEnd, leaving the GPU idle while this thread replays).
+    if(gpuProfile&&!eye_&&!bottomWorldPass_){
+        // Diagnostics: run what is recorded and wait for it; the GPU time of this
+        // category is from the previous category's completion to this one's.
+        gxCmdQueue_s& queue=__C3D_Context;
+        if(queue.maxEntries>=32&&queue.numEntries<20){
+            // The GPU is idle here (the previous category was waited for): time
+            // only this category's submitted work, not this thread's recording.
+            C3D_FrameSplit(GX_CMDLIST_FLUSH);
+            const uint64_t start=svcGetSystemTick();
+            gxCmdQueueRun(&queue);
+            gxCmdQueueWait(&queue,-1);
+            if(k<stats_.gpuCategoryMs.size())stats_.gpuCategoryMs[k]+=float((svcGetSystemTick()-start)*1000.0/SYSCLOCK_ARM11);
+        }
+    }else if(stats_.drawCalls!=stats_.categoryMark)kickGpu();
+    stats_.categoryMark=stats_.drawCalls;
